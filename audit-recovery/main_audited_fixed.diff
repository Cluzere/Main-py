+    def admit_user_request(self, user_id: int) -> tuple[bool, str]:
+        """In-memory per-user rate and daily quota guard."""
+        now = time.time()
+        recent = self.user_request_times[int(user_id)]
+        cutoff = now - 60.0
+        while recent and recent[0] <= cutoff:
+            recent.popleft()
+
+        day_key = time.strftime("%Y-%m-%d", time.gmtime(now))
+        if len(self.user_request_times) > 5000:
+            stale_users = [uid for uid, queue in self.user_request_times.items() if not queue or queue[-1] <= cutoff]
+            for stale_uid in stale_users[:1000]:
+                self.user_request_times.pop(stale_uid, None)
+        if len(self.user_daily_usage) > 5000:
+            for stale_uid, (stored_key, _) in list(self.user_daily_usage.items()):
+                if stored_key != day_key:
+                    self.user_daily_usage.pop(stale_uid, None)
+        stored_day, daily_count = self.user_daily_usage.get(int(user_id), (day_key, 0))
+        if stored_day != day_key:
+            daily_count = 0
+        if daily_count >= USER_DAILY_REQUEST_LIMIT:
+            return False, f"Batas harian {USER_DAILY_REQUEST_LIMIT} permintaan sudah tercapai. Batas dihitung ulang pukul 00:00 UTC."
+        if len(recent) >= USER_RATE_LIMIT_PER_MINUTE:
+            wait_seconds = max(1, int(60 - (now - recent[0])))
+            return False, f"Terlalu banyak permintaan. Coba lagi dalam sekitar {wait_seconds} detik."
+
+        recent.append(now)
+        self.user_daily_usage[int(user_id)] = (day_key, daily_count + 1)
+        return True, ""
 
